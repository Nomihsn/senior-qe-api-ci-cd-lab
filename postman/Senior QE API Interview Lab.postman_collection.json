    {
      "name": "Test1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "\r",
              "    pm.response.to.have.status(200);\r",
              "})\r",
              "\r",
              "pm.test(\"User Id Is:\", function(){\r",
              "    pm.expect(response.id).to.eql(1);\r",
              "})\r",
              "\r",
              "pm.test(\"User Name Is:\", function(){\r",
              "    pm.expect(response.name).to.eql(\"Leanne Graham\");\r",
              "})\r",
              "\r",
              "pm.test(\"Email field\", function(){\r",
              "\r",
              "    pm.expect(response).to.have.property(\"email\");\r",
              "})\r",
              "\r",
              "pm.test(function(){\r",
              "    pm.expect(typeof response.id).to.eql(\"number\");\r",
              "    pm.expect(Number.isInteger(response.id)).to.be.true;\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(function(){\r",
              "    pm.expect(typeof response.name).to.eql(\"string\");\r",
              "})\r",
              "\r",
              "pm.test(function(){\r",
              "\r",
              "    pm.expect(typeof response.email).to.eql(\"string\");\r",
              "})\r",
              "\r",
              "pm.test(function(){\r",
              "\r",
              "    pm.expect(typeof response.address).to.eql(\"object\")\r",
              "})\r",
              "\r",
              "pm.test(function(){\r",
              "\r",
              "    pm.expect(typeof response.address.city).to.eql(\"string\")\r",
              "})"
            ],
